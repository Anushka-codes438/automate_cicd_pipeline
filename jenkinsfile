
pipeline {
    agent { label 'ubuntu-agent' }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ubuntu-static-website:latest .'
            }
        }

        stage('Deploy Website') {
            steps {
                sh '''
                    docker rm -f static-website || true

                    docker run -d \
                      --name static-website \
                      --restart unless-stopped \
                      -p 8085:80 \
                      ubuntu-static-website:latest
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'curl --fail http://localhost:8085/'
            }
        }
    }

    post {
        success {
            echo 'Website deployed successfully!'
        }
        failure {
            echo 'Deployment failed. Check Console Output.'
        }
    }
}
